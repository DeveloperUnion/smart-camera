# Gemini API key used server-side by the Vercel Functions in /api.
# This single key powers both endpoints and must NEVER reach the browser:
# /api/live-token only hands the client a short-lived ephemeral token.
GEMINI_API_KEY=

# Live talk-mode model and its fallback (used by /api/live-token). The client
# tries the primary first, then the fallback on connect failure.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_FALLBACK_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# refine-items (post-stop identification) has its own optional overrides with
# sane defaults (gemini-3.5-flash → gemini-3.1-flash-lite), so they're omitted
# here. Set GEMINI_MODEL / GEMINI_FALLBACK_MODEL only to change them.
