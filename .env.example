# Gemini API key used server-side by the Vercel Functions in /api.
# This value must NEVER be exposed to the browser. /api/live-token holds it and
# only returns a short-lived ephemeral token to the client.
GEMINI_API_KEY=

# Live API model used by /api/live-token when minting ephemeral tokens.
# Default below; fallback candidate: gemini-3.1-flash-live-preview
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
